@model Asistente
@{
    ViewData["Title"] = "Nuevo asistente";
}

<h1>Nuevo asistente</h1>

<form asp-action="Create" class="col-md-6">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="Nombres" class="form-label"></label>
        <input asp-for="Nombres" class="form-control" />
        <span asp-validation-for="Nombres" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Dni" class="form-label"></label>
        <input asp-for="Dni" class="form-control" maxlength="8" inputmode="numeric" />
        <span asp-validation-for="Dni" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Correo" class="form-label"></label>
        <input asp-for="Correo" class="form-control" />
        <span asp-validation-for="Correo" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Telefono" class="form-label">Teléfono (opcional)</label>
        <input asp-for="Telefono" class="form-control" maxlength="9" inputmode="numeric" />
        <span asp-validation-for="Telefono" class="text-danger"></span>
    </div>
    <button class="btn btn-primary">Guardar</button>
    <a class="btn btn-outline-secondary" asp-action="Index">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

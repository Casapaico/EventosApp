@model IEnumerable<Asistente>
@{
    ViewData["Title"] = "Asistentes";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Asistentes</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo asistente</a>
</div>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Nombres</th>
            <th>DNI</th>
            <th>Correo</th>
            <th>Teléfono</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var a in Model)
        {
            <tr>
                <td>@a.Nombres</td>
                <td>@a.Dni</td>
                <td>@a.Correo</td>
                <td>@(string.IsNullOrEmpty(a.Telefono) ? "-" : a.Telefono)</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No hay asistentes registrados.</p>
}

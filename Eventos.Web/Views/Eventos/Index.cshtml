@model IEnumerable<EventoListadoItem>
@{
    ViewData["Title"] = "Eventos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1>Eventos</h1>
    <a class="btn btn-primary" asp-action="Create">Nuevo evento</a>
</div>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-sm-6 col-md-3">
        <select name="categoriaId" class="form-select" asp-items="ViewBag.Categorias">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-outline-primary">Filtrar</button>
        <a class="btn btn-outline-secondary" asp-action="Index">Limpiar</a>
    </div>
</form>

<table class="table table-striped align-middle">
    <thead>
        <tr>
            <th>Fecha</th>
            <th>Título</th>
            <th>Categoría</th>
            <th>Modalidad</th>
            <th>Lugar</th>
            <th class="text-end">Precio</th>
            <th class="text-center">Aforo</th>
            <th class="text-center">Inscritos</th>
            <th class="text-center">Cupos</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var e in Model)
        {
            <tr>
                <td class="text-nowrap">@e.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@e.Titulo</td>
                <td>@e.Categoria</td>
                <td>
                    <span class="badge @(e.Modalidad == "Virtual" ? "text-bg-info" : "text-bg-light border")">@e.Modalidad</span>
                </td>
                <td>@e.Lugar</td>
                <td class="text-end text-nowrap">@(e.Precio == 0 ? "Gratis" : e.Precio.ToString("C"))</td>
                <td class="text-center">@e.Aforo</td>
                <td class="text-center">@e.Confirmados</td>
                <td class="text-center">
                    @if (e.CuposDisponibles > 0)
                    {
                        <span class="badge text-bg-success">@e.CuposDisponibles</span>
                    }
                    else
                    {
                        <span class="badge text-bg-danger">Agotado</span>
                    }
                </td>
                <td class="text-end text-nowrap">
                    <a class="btn btn-sm btn-outline-secondary" asp-action="Details" asp-route-id="@e.Id">Detalle</a>
                    <a class="btn btn-sm btn-outline-primary" asp-action="Edit" asp-route-id="@e.Id">Editar</a>
                    <a class="btn btn-sm btn-outline-danger" asp-action="Delete" asp-route-id="@e.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p class="text-muted">No se encontraron eventos.</p>
}
